{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-syntax.mjs\"",
            "timeout": 20,
            "statusMessage": "Syntax prüfen …"
          }
        ]
      }
    ]
  }
}
